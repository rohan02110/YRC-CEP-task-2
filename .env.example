# ==============================================================================
# Chakravyuha v2 Hardening Environment Variables (Kurukshetra CTF)
# ==============================================================================

# Core Cryptographic Master Seed (DO NOT COMMIT YOUR PRODUCTION SEED TO GITHUB!)
# Used by HMAC-DRBG to derive unique team-specific rotor permutations and flags
MASTER_SEED=0x9F82A4C6E1D3B5792468ACE013579BDF2468ACE013579BDF2468ACE013579BDF

# Admin API Bearer Token (Protects /admin endpoints, hint releases, audit logs)
ADMIN_TOKEN=KURUKSHETRA_SACRED_ADMIN_TOKEN_2026

# Token Bucket Rate Limiting & Anti-Bruteforce Budgets
TOKEN_CAPACITY=400
TOKEN_REFILL_PER_HOUR=400
LIFETIME_KEYPRESS_CAP=2000
RESET_CHAKRA_COST=30
MAX_LOCKOUT_SECONDS=300

# SQLite Database Storage Location
DATABASE_PATH=/data/chakravyuha.db

